PORT=8842
CORS_ORIGIN=*

# Requests per minute per client address on /api, and failed sign-in attempts
# per 15 minutes; 0 turns a limit off. TRUST_PROXY: the number of reverse
# proxies in front of the API (1 behind nginx), 0 when clients connect directly.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=20
TRUST_PROXY=0

# Requests for a one-time code (sign in with a code, Forgot password) per
# 15 minutes per client address; each may send an email or a text message.
CODE_RATE_LIMIT=5

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=workman

JWT_SECRET=
JWT_EXPIRES_IN=7d

AUTH_TABLE=users
AUTH_ID_COLUMN=id
AUTH_EMAIL_COLUMN=email
AUTH_PASSWORD_COLUMN=password_hash
AUTH_NAME_COLUMN=name
AUTH_ROLE_COLUMN=role
AUTH_USERNAME_COLUMN=
AUTH_PHONE_COLUMN=
AUTH_PHOTO_COLUMN=photo

UPLOAD_MAX_MB=10

# Sending email (the app's automations, and the one-time codes of Forgot
# password and sign in with a code) and SMS (the codes). Email goes over SMTP
# (port 465 is TLS, others STARTTLS), SMS through Twilio (TWILIO_FROM is a
# number in +E.164 form). Left empty, each message is printed in the API's
# console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Where links in emails point (the web app's address). Empty: the address the
# web app was put online at from AppWand, and no links until then.
APP_URL=
# off: this copy of the API runs no scheduled jobs (when several copies run).
JOBS=

# Roles & permissions (plugin): change these in AppWand (Plugins).
ACCESS_ADMIN_ROLES=admin
ACCESS_FIRST_ADMIN=
ACCESS_DEFAULT_ROLE=

# Record ownership (plugin): change these in AppWand (Plugins).
OWNERSHIP_TABLES=tasks
OWNERSHIP_COLUMNS=tasks:assignee_id
OWNERSHIP_ROLES=tasks:admin|project_manager

# In-app notifications (plugin): change these in AppWand (Plugins).
NOTIFICATIONS_TABLES=tasks
NOTIFICATIONS_LIMIT=20
NOTIFICATIONS_TITLE=tasks:title
NOTIFICATIONS_DETAIL=tasks:priority|deadline
NOTIFICATIONS_IMAGE=tasks:
NOTIFICATIONS_TIME=tasks:created_at
NOTIFICATIONS_USER=
NOTIFICATIONS_READ=tasks:
NOTIFICATIONS_READ_VALUE=read
NOTIFICATIONS_UNREAD_VALUE=

# App search (plugin): change these in AppWand (Plugins).
SEARCH_TABLES=projects,tasks,teams,users
SEARCH_FIELDS=projects:name|description,tasks:title,teams:name,users:name|email
SEARCH_TITLE=projects:name,tasks:title,teams:name,users:name
SEARCH_SUBTITLE=projects:status,tasks:status|priority,teams:,users:email|role
SEARCH_PHOTO=projects:,tasks:,teams:,users:photo
SEARCH_LIMIT=5
