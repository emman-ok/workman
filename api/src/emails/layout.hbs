<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{subject}}</title>
<style>
  .content h1 { font-size: 22px; line-height: 1.3; margin: 0 0 16px; color: #111827; }
  .content h2 { font-size: 17px; line-height: 1.4; margin: 24px 0 10px; color: #111827; }
  .content p { margin: 0 0 14px; }
  .content a { color: {{color}}; }
  .content ul, .content ol { margin: 0 0 14px; padding-left: 22px; }
  .content table { width: 100%; border-collapse: collapse; margin: 0 0 16px; }
  .content th { text-align: left; font-size: 14px; color: #6b7280; font-weight: 600; padding: 8px 10px; border-bottom: 2px solid #e5e7eb; }
  .content td { padding: 10px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
  .content .muted { color: #6b7280; }
</style>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;">
        <tr>
          <td style="background:{{color}};color:{{onColor}};padding:18px 28px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:700;">{{appName}}</td>
        </tr>
        <tr>
          <td class="content" style="padding:28px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#374151;">
{{{body}}}
          </td>
        </tr>
      </table>
      <p style="margin:16px 0 0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;color:#9ca3af;">
        Sent by {{appName}}{{#if appUrl}} &middot; <a href="{{appUrl}}" style="color:#9ca3af;">{{appUrl}}</a>{{/if}}
      </p>
    </td>
  </tr>
</table>
</body>
</html>
